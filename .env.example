TENANT_ID=your-azure-tenant-id
CLIENT_ID=your-azure-app-client-id
CLIENT_SECRET=your-azure-app-client-secret
MAILBOX_USER=mailbox@yourdomain.com
MAX_THREAD_MESSAGES=5
MAX_THREAD_CHARS_PER_MESSAGE=1200
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
TEAMS_CHANNEL_EMAIL=your-teams-channel-email@ae.teams.ms
ADDRESSING_NAME=your-first-name
EMAIL_SIGNATURE=Best regards,\nYour Name\nYour Job Title
PERSONA_DESCRIPTION=Your Name, Your Job Title at Your Company
VIP_SENDERS=investor@fund.com,client@bigco.com
VIP_DOMAINS=bigco.com
N8N_ACTION_WEBHOOK_URL=https://ednexautomation.app.n8n.cloud/webhook/email-bot-action
LINK_EXPIRY_DAYS=3
DEV_MODE=false

# Skip newsletters, promotions, cold sales outreach and system notifications (default true).
# Threads the mailbox owner has already replied in are never skipped.
MARKETING_FILTER=true
# Always skip these senders / domains (comma-separated).
SKIP_SENDERS=
SKIP_DOMAINS=
# Learn the owner's writing style from Sent Items, refreshed every 24 h (default true).
STYLE_LEARNING=true
STYLE_SAMPLE_SIZE=40
# Read PDF / Word / Excel / text attachments into the summary and reply (default true).
ATTACHMENTS_ENABLED=true
ATTACHMENT_MAX_MB=10
ATTACHMENT_MAX_CHARS=6000
# Daily Teams digest of sent emails with no reply (default true).
FOLLOWUP_ENABLED=true
FOLLOWUP_AFTER_DAYS=3
FOLLOWUP_LOOKBACK_DAYS=14
# Hour of day (Dubai time) the digest is sent.
FOLLOWUP_DIGEST_HOUR=9
# Recipients at these domains don't count as waiting (default: the mailbox's own domain).
# FOLLOWUP_IGNORE_DOMAINS=ednex.me

# Detect tenders/RFQs and finance/legal matters: flag them in Outlook (due date =
# deadline, category Tender/Finance/Legal) and alert Teams (default true).
TRACKING_ENABLED=true
# Emails from these domains (and subdomains) always count as possible finance matters.
# FINANCE_SENDER_DOMAINS=adcb.com,dbs.com,adib.ae,emiratesnbd.com,bankfab.com,fab.ae,mashreq.com,rakbank.ae,cbd.ae,hsbc.ae,icici.bank.in,icicibank.com,nesl.co.in,gov.ae
# Optional private destination for finance/legal alerts; when set, the shared
# briefing only shows a count. Default: the normal Teams channel.
# FINANCE_ALERT_EMAIL=
# Tenders (never finance) also go to a "Tenders" tab of the lead Google Sheet
# (lead_config.json), using the same Google service account key as the lead bot.
TENDER_SHEET_ENABLED=true
# TENDER_SHEET_ID=
# TENDER_SHEET_TAB=Tenders
# Morning briefing in Teams (replaces the separate follow-up digest) (default true).
BRIEFING_ENABLED=true
BRIEFING_HOUR=8

# Lead automation (separate app registration: Lead-Email-Automation)
LEAD_CLIENT_ID=your-lead-app-client-id
LEAD_CLIENT_SECRET=your-lead-app-client-secret
# LEAD_TENANT_ID falls back to TENANT_ID if unset
LEAD_POLL_MINUTES=15
# Google Sheet storage ("storage": "google_sheets" in lead_config.json).
# Either put the service account key in google_service_account.json (gitignored;
# on Render, a Secret File with that name) or paste its JSON here on one line.
# GOOGLE_SERVICE_ACCOUNT_FILE=google_service_account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
